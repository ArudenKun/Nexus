{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "%LOG_BASE_PATH%/logs.txt",
                "rollingInterval": 3,
                "rollOnFileSizeLimit": true,
                "retainedFileTimeLimit":  14
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Data Source=../../Nexus.db;"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "nvx82b5pnUAxogQp"
  }
}