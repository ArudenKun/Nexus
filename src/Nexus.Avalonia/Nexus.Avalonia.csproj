<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Nexus</RootNamespace>
  </PropertyGroup>

  <!-- Detect browser consuming project via TFM -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browser' OR '$(TargetFrameworkIdentifier)' == 'Browser'">
    <DefineConstants>$(DefineConstants);BROWSER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AnimatedImage.Avalonia" Version="2.1.4" />
    <PackageReference Include="AnimatedImage.Native" Version="2.1.2" />
    <PackageReference Include="AsyncImageLoader.Avalonia" Version="4.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="AvaloniaRichEditor" Version="1.3.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Configuration.Writable" Version="0.9.1" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="Lucide.Avalonia" Version="0.2.30" />
    <PackageReference Include="ServiceScan.SourceGenerator" Version="3.2.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Tabalonia" Version="12.0.0" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.7.1" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup Label="HotAvalonia">
    <PackageReference
      Include="Avalonia.Markup.Xaml.Loader"
      Version="12.1.6"
      PrivateAssets="All"
      Publish="True"
    />
    <PackageReference Include="HotAvalonia" Version="3.1.5" PrivateAssets="All" Publish="True" />
    <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.6" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\modules\Fluently.Avalonia\Fluently.Avalonia.csproj" />
    <ProjectReference Include="..\Nexus.Application\Nexus.Application.csproj" />
    <ProjectReference Include="..\Nexus.EntityFrameworkCore\Nexus.EntityFrameworkCore.csproj" />
  </ItemGroup>
</Project>
