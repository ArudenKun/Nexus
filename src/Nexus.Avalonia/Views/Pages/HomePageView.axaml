<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="800"
  d:DesignHeight="450"
  xmlns:nexus="https://github.com/arudenkun/nexus"
  x:DataType="nexus:HomePageViewModel"
  x:Class="Nexus.Views.Pages.HomePageView"
>
  <StackPanel>
    <Button Command="{Binding  SetBusyCommand}">Set Busy</Button>
  </StackPanel>
</UserControl>
