<UserControl
  x:Class="Nexus.Controls.BusyArea"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:nexus="https://github.com/arudenkun/nexus"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <UserControl.Styles>
    <!-- Transition on the loading overlay (templated part => must use /template/) -->
    <Style Selector="nexus|BusyArea /template/ DockPanel#LoadingBusyArea">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="nexus|BusyArea[IsBusy=True] /template/ DockPanel#LoadingBusyArea">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="nexus|BusyArea[IsBusy=False] /template/ DockPanel#LoadingBusyArea">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Transition on the busy content -->
    <Style Selector="nexus|BusyArea /template/ ContentControl#BusyContent">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="nexus|BusyArea[IsBusy=True] /template/ ContentControl#BusyContent">
      <Setter Property="Opacity" Value="0.1" />
    </Style>

    <Style Selector="nexus|BusyArea[IsBusy=False] /template/ ContentControl#BusyContent">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="nexus|BusyArea">
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <ContentControl Name="BusyContent" Content="{TemplateBinding Content}" Opacity="1" />

            <DockPanel
              Name="LoadingBusyArea"
              Opacity="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              LastChildFill="True"
            >
              <TextBlock
                Margin="3"
                DockPanel.Dock="Bottom"
                Name="PART_BusyText"
                FontWeight="DemiBold"
                IsVisible="{TemplateBinding IsBusy}"
                Text="{TemplateBinding BusyText}"
              />

              <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Content="{TemplateBinding IsBusy,
                                                         Converter={x:Static nexus:ProgressToContentConverter.Instance}}"
              />
            </DockPanel>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>
</UserControl>
