@page "/authors"
@attribute [Authorize(NexusPermissions.Authors.Default)]
@using System.Threading
@using Nexus.Permissions
@using Volo.Abp.Application.Dtos
@using Nexus.Authors
@inject IAuthorAppService AuthorAppService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inherits NexusComponentBase
<MudCard>
    <MudCardContent>
        <MudGrid Class="mb-3 align-center">
            <MudItem xs="12" lg="8"><MudText Typo="Typo.h6">@L["Menu:Authors"]</MudText></MudItem>
            <MudItem xs="12" lg="4" Class="d-flex justify-end gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAuthorsAsync">@L["ExportToExcel"]</MudButton>
                @if (HasCreatePermission) { <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@L["NewAuthor"]</MudButton> }
            </MudItem>
        </MudGrid>
        <MudDataGrid @ref="_dataGrid" T="AuthorDto" ServerData="OnDataGridReadAsync" RowsPerPage="@PageSize" SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="@L["Actions"]" Sortable="false"><CellTemplate><MudMenu Icon="@Icons.Material.Filled.MoreVert" Variant="Variant.Text" Dense="true">@if (HasUpdatePermission) { <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditDialogAsync(context.Item))">@L["Edit"]</MudMenuItem> }@if (HasDeletePermission) { <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteEntityAsync(context.Item))">@L["Delete"]</MudMenuItem> }</MudMenu></CellTemplate></TemplateColumn>
                <PropertyColumn Property="x => x.Name" Title="@L["Name"]" />
                <TemplateColumn Title="@L["BirthDate"]"><CellTemplate>@context.Item.BirthDate.ToShortDateString()</CellTemplate></TemplateColumn>
                <PropertyColumn Property="x => x.ShortBio" Title="@L["ShortBio"]" />
                <TemplateColumn Title="@L["CreationTime"]"><CellTemplate>@context.Item.CreationTime.ToLongDateString()</CellTemplate></TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="AuthorDto" /></PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>
<MudDialog @bind-Visible="_createDialogVisible" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">@L["NewAuthor"]</MudText></TitleContent><DialogContent><MudForm @ref="_createForm" Model="@NewEntity"><MudTextField @bind-Value="NewEntity.Name" Label="@L["Name"]" AutoFocus="true" Immediate="true" OnlyValidateIfDirty="true" Margin="Margin.Dense" Required="true" RequiredError="@L["The {0} field is required.", L["Name"]]" /><MudDatePicker @bind-Date="_newEntityBirthDate" Label="@L["BirthDate"]" Margin="Margin.Dense" /><MudTextField @bind-Value="NewEntity.ShortBio" Label="@L["ShortBio"]" Lines="4" Margin="Margin.Dense" /></MudForm></DialogContent><DialogActions><MudButton OnClick="CloseCreateDialog">@L["Cancel"]</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateEntityAsync">@L["Save"]</MudButton></DialogActions></MudDialog>
<MudDialog @bind-Visible="_editDialogVisible" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">@L["Edit"]</MudText></TitleContent><DialogContent><MudForm @ref="_editForm" Model="@EditingEntity"><MudTextField @bind-Value="EditingEntity.Name" Label="@L["Name"]" Margin="Margin.Dense" Required="true" RequiredError="@L["The {0} field is required.", L["Name"]]" /><MudDatePicker @bind-Date="_editingEntityBirthDate" Label="@L["BirthDate"]" Margin="Margin.Dense" /><MudTextField @bind-Value="EditingEntity.ShortBio" Label="@L["ShortBio"]" Lines="4" Margin="Margin.Dense" /></MudForm></DialogContent><DialogActions><MudButton OnClick="CloseEditDialog">@L["Cancel"]</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="UpdateEntityAsync">@L["Save"]</MudButton></DialogActions></MudDialog>
@code
{
    private MudDataGrid<AuthorDto> _dataGrid = default!;
    private MudForm? _createForm;
    private MudForm? _editForm;
    private bool _createDialogVisible;
    private bool _editDialogVisible;
    private DateTime? _newEntityBirthDate;
    private DateTime? _editingEntityBirthDate;
    private const int PageSize = 10;
    private CreateUpdateAuthorDto NewEntity { get; set; } = new();
    private CreateUpdateAuthorDto EditingEntity { get; set; } = new();
    private Guid EditingEntityId { get; set; }
    private bool HasCreatePermission { get; set; }
    private bool HasUpdatePermission { get; set; }
    private bool HasDeletePermission { get; set; }
    private DialogOptions DialogOptions => new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false };
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); HasCreatePermission = (await AuthorizationService.AuthorizeAsync(NexusPermissions.Authors.Create)).Succeeded; HasUpdatePermission = (await AuthorizationService.AuthorizeAsync(NexusPermissions.Authors.Edit)).Succeeded; HasDeletePermission = (await AuthorizationService.AuthorizeAsync(NexusPermissions.Authors.Delete)).Succeeded; }
    private async Task<GridData<AuthorDto>> OnDataGridReadAsync(GridState<AuthorDto> state, CancellationToken cancellationToken = default) { var result = await AuthorAppService.GetListAsync(new PagedAndSortedResultRequestDto { MaxResultCount = state.PageSize, SkipCount = state.Page * state.PageSize }); return new GridData<AuthorDto> { Items = result.Items, TotalItems = (int)result.TotalCount }; }
    private Task OpenCreateDialogAsync() { NewEntity = new CreateUpdateAuthorDto { BirthDate = DateTime.Now }; _newEntityBirthDate = NewEntity.BirthDate; _createDialogVisible = true; return Task.CompletedTask; }
    private void CloseCreateDialog() { _createDialogVisible = false; }
    private async Task CreateEntityAsync() { if (_createForm != null) { await _createForm.ValidateAsync(); if (!_createForm.IsValid) return; } if (_newEntityBirthDate.HasValue) NewEntity.BirthDate = _newEntityBirthDate.Value; await AuthorAppService.CreateAsync(NewEntity); _createDialogVisible = false; await InvokeAsync(() => _dataGrid.ReloadServerData()); Snackbar.Add(L["SuccessfullySaved"], Severity.Success); }
    private Task OpenEditDialogAsync(AuthorDto entity) { EditingEntityId = entity.Id; EditingEntity = new CreateUpdateAuthorDto { Name = entity.Name, BirthDate = entity.BirthDate, ShortBio = entity.ShortBio }; _editingEntityBirthDate = EditingEntity.BirthDate; _editDialogVisible = true; return Task.CompletedTask; }
    private void CloseEditDialog() { _editDialogVisible = false; }
    private async Task UpdateEntityAsync() { if (_editForm != null) { await _editForm.ValidateAsync(); if (!_editForm.IsValid) return; } if (_editingEntityBirthDate.HasValue) EditingEntity.BirthDate = _editingEntityBirthDate.Value; await AuthorAppService.UpdateAsync(EditingEntityId, EditingEntity); _editDialogVisible = false; await InvokeAsync(() => _dataGrid.ReloadServerData()); Snackbar.Add(L["SuccessfullySaved"], Severity.Success); }
    private async Task DeleteEntityAsync(AuthorDto entity) { var confirmed = await DialogService.ShowMessageBoxAsync(L["AreYouSure"], string.Format(L["AreYouSureToDelete"], entity.Name), yesText: L["Yes"], cancelText: L["Cancel"]); if (confirmed != true) return; await AuthorAppService.DeleteAsync(entity.Id); await InvokeAsync(() => _dataGrid.ReloadServerData()); Snackbar.Add(L["SuccessfullyDeleted"], Severity.Success); }
    private async Task ExportAuthorsAsync() { var token = await AuthorAppService.GetDownloadTokenAsync(); NavigationManager.NavigateTo($"/api/app/author/as-excel-file?downloadToken={Uri.EscapeDataString(token.Token)}", forceLoad: true); }
}
