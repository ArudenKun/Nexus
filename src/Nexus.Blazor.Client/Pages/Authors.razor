@page "/authors"
@attribute [Authorize(NexusPermissions.Authors.Default)]
@using Nexus.Permissions
@using Nexus.Authors
@inject IAuthorAppService AuthorAppService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inherits NexusComponentBase
<MudCard>
    <MudCardContent>
        <MudGrid Class="mb-3 align-center">
            <MudItem xs="12" lg="8"><MudText Typo="Typo.h6">@L["Menu:Authors"]</MudText></MudItem>
            <MudItem xs="12" lg="4" Class="d-flex justify-end gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAuthorsAsync">@L["ExportToExcel"]</MudButton>
                @if (HasCreatePermission)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@L["NewAuthor"]</MudButton>
                }
            </MudItem>
        </MudGrid>
        <MudDataGrid @ref="_dataGrid" T="AuthorDto" ServerData="OnDataGridReadAsync" RowsPerPage="@PageSize" SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="@L["Actions"]" Sortable="false">
                    <CellTemplate>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Variant="Variant.Text" Dense="true">
                            @if (HasUpdatePermission)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditDialogAsync(context.Item))">@L["Edit"]</MudMenuItem>
                            }
                            @if (HasDeletePermission)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteEntityAsync(context.Item))">@L["Delete"]</MudMenuItem>
                            }
                        </MudMenu>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Name" Title="@L["Name"]" />
                <TemplateColumn Title="@L["BirthDate"]"><CellTemplate>@context.Item.BirthDate.ToShortDateString()</CellTemplate></TemplateColumn>
                <PropertyColumn Property="x => x.ShortBio" Title="@L["ShortBio"]" />
                <TemplateColumn Title="@L["CreationTime"]"><CellTemplate>@context.Item.CreationTime.ToLongDateString()</CellTemplate></TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="AuthorDto" /></PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>
<MudDialog @bind-Visible="_createDialogVisible" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">@L["NewAuthor"]</MudText></TitleContent><DialogContent><MudForm @ref="_createForm" Model="@NewEntity"><MudTextField @bind-Value="NewEntity.Name" Label="@L["Name"]" AutoFocus="true" Immediate="true" OnlyValidateIfDirty="true" Margin="Margin.Dense" Required="true" RequiredError="@L["The {0} field is required.", L["Name"]]" /><MudDatePicker @bind-Date="_newEntityBirthDate" Label="@L["BirthDate"]" Margin="Margin.Dense" /><MudTextField @bind-Value="NewEntity.ShortBio" Label="@L["ShortBio"]" Lines="4" Margin="Margin.Dense" /></MudForm></DialogContent><DialogActions><MudButton OnClick="CloseCreateDialog">@L["Cancel"]</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateEntityAsync">@L["Save"]</MudButton></DialogActions></MudDialog>
<MudDialog @bind-Visible="_editDialogVisible" Options="DialogOptions"><TitleContent><MudText Typo="Typo.h6">@L["Edit"]</MudText></TitleContent><DialogContent><MudForm @ref="_editForm" Model="@EditingEntity"><MudTextField @bind-Value="EditingEntity.Name" Label="@L["Name"]" Margin="Margin.Dense" Required="true" RequiredError="@L["The {0} field is required.", L["Name"]]" /><MudDatePicker @bind-Date="_editingEntityBirthDate" Label="@L["BirthDate"]" Margin="Margin.Dense" /><MudTextField @bind-Value="EditingEntity.ShortBio" Label="@L["ShortBio"]" Lines="4" Margin="Margin.Dense" /></MudForm></DialogContent><DialogActions><MudButton OnClick="CloseEditDialog">@L["Cancel"]</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="UpdateEntityAsync">@L["Save"]</MudButton></DialogActions></MudDialog>