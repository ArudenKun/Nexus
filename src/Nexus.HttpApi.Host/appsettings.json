{
  "App": {
    "SelfUrl": "https://localhost:44310",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Data Source=../../Nexus.db;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44310",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "Nexus_Swagger",
    "CertificatePassPhrase": "4f2ce5e2-1d37-40c5-854d-669e16fd77bd"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "nvx82b5pnUAxogQp"
  }}